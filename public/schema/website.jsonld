{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Gebauer Watches",
  "url": "https://gebauerwatches.com",
  "description": "Handcrafted wooden watches by Gebauer Watches",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://gebauerwatches.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  },
  "founder": [
    {
      "@type": "Person",
      "name": "Liam Gebauer"
    },
    {
      "@type": "Person",
      "name": "Sarah Gebauer"
    }
  ],
  "areaServed": {
    "@type": "Place",
    "name": "Steamboat Springs, Colorado"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Gebauer Watches Collection",
    "itemListElement": [
      {
        "@type": "Product",
        "name": "Cherry Watch",
        "offers": {
          "@type": "Offer",
          "price": "299",
          "priceCurrency": "USD"
        }
      },
      {
        "@type": "Product",
        "name": "Black Ebony Watch",
        "offers": {
          "@type": "Offer",
          "price": "339",
          "priceCurrency": "USD"
        }
      },
      {
        "@type": "Product",
        "name": "African Padauk Watch",
        "offers": {
          "@type": "Offer",
          "price": "375",
          "priceCurrency": "USD"
        }
      }
    ]
  }
}